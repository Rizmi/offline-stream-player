# ==============================================================================
# Offline Stream Player - Configuration
# Copy this file to .env and adjust values for your setup.
# All media downloads, temp files, thumbnails, and metadata stay in DOWNLOAD_DIR.
# ==============================================================================

# Directory where all videos, chats, temp files, and .osp-cache are stored
DOWNLOAD_DIR=/mnt/Extras

# Web server binding
HOST=127.0.0.1
PORT=8765

# Browser to auto-open on start.sh (leave empty for xdg-open/system default)
BROWSER=zen-browser
AUTO_OPEN_BROWSER=true

# YouTube download defaults (via yt-dlp)
# Examples: bestvideo+bestaudio/best, bestvideo[height<=1440]+bestaudio/best, bestvideo[height<=1080]+bestaudio/best
YT_QUALITY=bestvideo+bestaudio/best
YT_FORMAT=mkv
YT_CONCURRENT_FRAGMENTS=4

# Optional YouTube authentication for age-restricted / member-only / bot-checked streams
# Browser examples: zen, firefox, chrome, chromium, brave, edge, vivaldi, opera, safari (or leave empty)
YT_COOKIES_FROM_BROWSER=
# Optional path to Netscape cookies.txt file (overrides YT_COOKIES_FROM_BROWSER when set)
YT_COOKIES_FILE=

# Kick download & chat settings
KICK_CHAT_WORKERS=1
KICK_REQUEST_DELAY=0.25

# Library thumbnail generation timestamp in seconds (clamped for shorter videos)
THUMBNAIL_SEEK_SEC=120
